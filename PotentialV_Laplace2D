                    antialiased=True)
    ax.set_title(title)
    ax.set_xlabel("x"); ax.set_ylabel("y"); ax.set_zlabel(zlabel)
    if zlim is not None:
        ax.set_zlim(*zlim)
    ax.view_init(elev=25, azim=-60)                # camera angle: height and rotation

