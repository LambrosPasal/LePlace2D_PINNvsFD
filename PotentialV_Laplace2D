# DOMAIN DISCRITIZATION function
def grid(N):
  n = N+2
  h = 1.0 / (n-1)
  x = np.linspace(0, 1, n)
  y = np.linspace(0, 1, n)
  X, Y = np.meshgrid(x, y, indexing="xy")  
  return X,Y

# ANALYTIC SOLUTION method
def V_exact(N):
  X, Y = grid(N)   # V[j, i]: row j <-> y, column i <-> x
  V_ex = np.sin(np.pi * X) * np.sinh(np.pi * Y) / np.sinh(np.pi)
  return V_ex

# FINITE DIFFERENCES method
def finite_diff(N):
  X_fd, Y_fd = grid(N)   # V[j, i]: row j <-> y, column i <-> x
  n = N+2
  # Initial guess: zero everywhere, then set the boundary values
  V_fd = np.zeros((n, n))
  # top row (y = 1): the lid,  bottom row, left column, right column stay 0 (grounded)
  V_fd[-1, :] = np.sin(np.pi * X_fd[0])    

  tol = 1e-8
  t0 = time.time()
  for iteration in range(100_000):
      V_new = V_fd.copy()
      # every interior point <- average of its 4 neighbours
      V_new[1:-1, 1:-1] = 0.25 * (V_fd[1:-1, 2:]+ V_fd[1:-1, :-2]+ V_fd[2:, 1:-1]+ V_fd[:-2, 1:-1])  
      change = np.abs(V_new - V_fd).max()
      V_fd = V_new
      if change < tol:
          break
  t_fd = time.time() - t0
  return V_fd, t_fd

