# Recall we have  N_GRID**2 total points
# INTERIROR
# 1-D coordinates strictly INSIDE (0, 1): drop the first and last value (0 and 1)
g = torch.linspace(0, 1, N_GRID + 2)[1:-1]
# 2-D grid: every combination of an x-value and a y-value
X, Y = torch.meshgrid(g, g, indexing="xy")
# Flatten the two 2-D arrays into one list of (x, y) points
xy_interior = torch.stack([X.flatten(), Y.flatten()], dim=1)

# BOUNDARY
# Evenly spaced positions along an edge, INCLUDING the corners (0 and 1)
e = torch.linspace(0, 1, N_GRID).unsqueeze(1)     # shape (100, 1)
zeros = torch.zeros_like(e)
ones  = torch.ones_like(e)

bottom = torch.cat([e, zeros], dim=1)   # y = 0
top    = torch.cat([e, ones],  dim=1)   # y = 1
left   = torch.cat([zeros, e], dim=1)   # x = 0
right  = torch.cat([ones,  e], dim=1)   # x = 1

V_top    = torch.sin(torch.pi * top[:, 0:1])   # V = sin(pi x) on the lid
V_bottom = torch.zeros_like(e)
V_left   = torch.zeros_like(e)
V_right  = torch.zeros_like(e)

xy_boundary = torch.cat([bottom, top, left, right], dim=0)
V_boundary  = torch.cat([V_bottom, V_top, V_left, V_right], dim=0)

# ------------ PINN Method --------------
import torch.nn as nn
class PINN(nn.Module):
    """Neural network V(x, y): takes (N, 2) points, returns (N, 1) potentials."""

    def __init__(self, input, output, width, depth):
        super().__init__()
        layers = []
        in_features=input                  # input: (x, y)
        for _ in range(depth):
            layers.append(nn.Linear(in_features, width))
            layers.append(nn.Tanh())             # smooth activation - ReLU would NOT work (see below)
            in_features = width
        layers.append(nn.Linear(width, output))       # output: V (no activation)
        self.net = nn.Sequential(*layers)

        for m in self.net:                       # Xavier init: good default for tanh
            if isinstance(m, nn.Linear):
                nn.init.xavier_normal_(m.weight)
                nn.init.zeros_(m.bias)

    def forward(self, xy):
        return self.net(xy)

# Defining the custom Poisson based LOSS FUNCTION
def laplacian(f, xy):
    """d2f/dx2 + d2f/dy2 at each point. f maps (N, 2) -> (N, 1): the network or any test function."""
    xy = xy.clone().requires_grad_(True)
    V = f(xy)
    dV = torch.autograd.grad(V, xy, torch.ones_like(V), create_graph=True)[0]
    V_xx = torch.autograd.grad(dV[:, 0:1], xy, torch.ones_like(V), create_graph=True)[0][:, 0:1]
    V_yy = torch.autograd.grad(dV[:, 1:2], xy, torch.ones_like(V), create_graph=True)[0][:, 1:2]
    return V_xx + V_yy

def pinn_loss(model):
    # Rule 1: Laplace's equation inside the box
    residual = laplacian(model, xy_interior)          # (400, 1)
    loss_pde = (residual ** 2).mean()

    # Rule 2: the boundary values
    V_pred_bc = model(xy_boundary)                    # (400, 1)
    loss_bc = ((V_pred_bc - V_boundary) ** 2).mean()

    return loss_pde, loss_bc

# TRAINING
# Network dimensions, and hyperparameters
input=2
output=1
width=32
depth=4
max_epochs= 20000
lamda=1e-1

model = PINN(input,output,width,depth)
optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
history = {"pde": [], "bc": [], "total": []}

t0 = time.time()
for it in range(max_epochs):
    optimizer.zero_grad()                         # 1. clear old gradients
    loss_pde, loss_bc = pinn_loss(model)          # 2. evaluate both rules
    loss = lamda*loss_pde + loss_bc                     # 3. combine
    loss.backward()                               # 4. gradients of the loss w.r.t. the WEIGHTS
    optimizer.step()                              # 5. update the weights

    history["pde"].append(loss_pde.item())
    history["bc"].append(loss_bc.item())
    history["total"].append(loss.item())

    if it % 5000 == 0 or it == max_epochs - 1:
        print(f"iter {it:5d} | total {loss.item():.3e} | PDE {loss_pde.item():.3e} | BC {loss_bc.item():.3e}")

t_pinntrain = time.time() - t0
print(f"\n PINN Training Time: {t_pinntrain:.4f} s")

fig, ax = plt.subplots(figsize=(7, 4))
ax.semilogy(history["total"], label="total", lw=2)
ax.semilogy(history["pde"],   label="PDE (interior)", lw=1)
ax.semilogy(history["bc"],    label="BC (edges)",     lw=1)
ax.set_xlabel("iteration"); ax.set_ylabel("loss (log scale)")
ax.set_title("PINN training")
ax.legend(); ax.grid(alpha=0.3, which="both")
plt.show()

