def surface(ax, N, Z, title, cmap="viridis", zlim=None, zlabel="V"):
    """Draw Z(x, y) as a 3-D surface on a 3-D axis."""
    X, Y = grid(N)
    ax.plot_surface(X, Y, Z, cmap=cmap,
                    rcount=60, ccount=60,          # max rows/cols drawn: keeps big grids fast
